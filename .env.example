# ===== 文本模型（DeepSeek）=====
# 不填则自动使用 mock 数据（UI 完整可演示）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# ===== 百度智能云 OCR（订单识别用）=====
# 注册流程：
#   1. https://cloud.baidu.com 注册账号
#   2. 进入控制台，开通"文字识别"服务
#   3. 创建应用，获取 API Key 和 Secret Key
#   4. 免费额度：通用文字识别标准版 1000 次/天
# 不填则订单识别功能使用 mock 数据演示，其他功能不受影响
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ===== Mock 模式（开发用，无 Key 也能跑通）=====
MOCK_MODE=false
