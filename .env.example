# ===== DeepSeek API =====
# 不填则自动使用 mock 数据（UI 完整可演示）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# max_tokens：普通模型 1500 够用，推理模型（如 deepseek-v4-flash）建议 6000+
OPENAI_MAX_TOKENS=6000

# ===== 百度智能云 OCR（订单识别用）=====
BAIDU_OCR_API_KEY=xxxx
BAIDU_OCR_SECRET_KEY=xxxx

# ===== Supabase =====
# 在 Supabase 项目 Settings > API 中获取
#
# NEXT_PUBLIC_ 前缀的变量会暴露到前端 —— 这是必须的，anon key 本就是公开凭证
# 旧版 Supabase 界面（Settings > API）显示 "anon key"（eyJ... 格式）
# 新版 Supabase 界面显示 "Publishable key"（sb_publishable_... 格式）——两者等价，填其中一个即可
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
# 或（新版界面）：
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Service Role Key：绝对不要加 NEXT_PUBLIC_ 前缀！
# 仅在服务端脚本中使用，前端代码永远不可访问
# Prompt 1 阶段不会用到，但提前列出备用
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# ===== Mock 模式 =====
MOCK_MODE=false

# ===== Admin Dashboard =====
# ⚠️ NEXT_PUBLIC_ 会暴露到前端——demo 可接受，生产环境应改用 server-side 验证
NEXT_PUBLIC_ADMIN_PASSWORD=demo2026
