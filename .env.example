# OpenAI / Compatible API Key
# 不填则自动使用 mock 数据（UI 完整可演示）
OPENAI_API_KEY=

# API Base URL（支持替换为国内大模型，如 DeepSeek、智谱等 OpenAI 兼容接口）
# 默认使用 OpenAI 官方地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型（默认 gpt-4o-mini，可换成 deepseek-chat 等）
OPENAI_MODEL=gpt-4o-mini

# 多模态视觉模型（用于订单截图 OCR，默认与文本模型一致）
# DeepSeek V3 系列原生支持视觉输入，可直接设为 deepseek-chat 等
OPENAI_VISION_MODEL=gpt-4o-mini

# Mock 模式开关（不配 API Key 时自动启用，也可手动强制开启）
MOCK_MODE=false
